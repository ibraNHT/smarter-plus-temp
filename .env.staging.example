# STAGING build-time vars for the Connect web app.
# These are inlined by Vite at BUILD time. In CI they are passed as Docker
# --build-arg values (see .github/workflows/deploy.yml). Payments stay ON.

VITE_API_BASE_URL=https://api.staging.agrimarketconnect.shop
VITE_PAYMENTS_ENABLED=true

VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
# Namespace browser uploads to the staging folder (matches API CLOUDINARY_FOLDER_PREFIX).
VITE_CLOUDINARY_FOLDER_PREFIX=agrimarket/staging
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key
