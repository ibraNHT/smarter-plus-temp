# VPS runtime vars for the web container's docker-compose.yml.
# Copy to `.env` next to docker-compose.yml in each environment directory.
#
# staging-web/.env:
#   COMPOSE_PROJECT_NAME=agrimarket-web-staging
#   WEB_IMAGE=ghcr.io/ati-organisation/webapp-agrimarket-connect:staging
#   WEB_HOST_PORT=8081
#   OG_API_BASE_URL=https://api.staging.acheteici.com
#   SITE_ORIGIN=https://staging.acheteici.com
#
# prod-web/.env:
#   COMPOSE_PROJECT_NAME=agrimarket-web-prod
#   WEB_IMAGE=ghcr.io/ati-organisation/webapp-agrimarket-connect:prod
#   WEB_HOST_PORT=8080
#   OG_API_BASE_URL=https://api.acheteici.com
#   SITE_ORIGIN=https://acheteici.com

COMPOSE_PROJECT_NAME=agrimarket-web-prod
WEB_IMAGE=ghcr.io/ati-organisation/webapp-agrimarket-connect:prod
WEB_HOST_PORT=8080
OG_API_BASE_URL=https://api.acheteici.com
SITE_ORIGIN=https://acheteici.com
