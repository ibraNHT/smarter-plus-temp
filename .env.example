# Copy to .env for local dev. On Vercel, set these in Project → Settings → Environment Variables.

VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Production API (required on Vercel — do NOT use localhost in deployed builds)
VITE_API_BASE_URL=https://backendtest.agrimarketconnect.shop

# Native / Capacitor binaries: bake a public HTTPS API. Example:
# VITE_API_BASE_URL=https://api.acheteici.com
# VITE_WEB_ORIGIN=https://acheteici.com
# VITE_NATIVE is set automatically by `yarn build:native`.

# Local dev example (optional — Vite proxy also works with an empty value)
# VITE_API_PROXY_TARGET=http://localhost:3000
# VITE_API_BASE_URL=http://localhost:3000

VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
